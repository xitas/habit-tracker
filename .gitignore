# .gitignore for an Expo (React Native + TypeScript) app using npm.
# Lock files (package-lock.json etc.) are intentionally NOT ignored: keep them committed.

# ---- Dependencies ----
node_modules/
.pnp/
.pnp.*
Pods/

# ---- Expo / Metro ----
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*
web-build/

# ---- Build outputs ----
build/
dist/
.next/
*.tsbuildinfo
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip

# ---- Native projects ----
# android/ and ios/ are generated by `npx expo prebuild` (Continuous Native Generation).
/android
/ios
# Build folders, in case the native projects are ever committed.
android/app/build/
android/build/
android/.gradle/
ios/build/
.kotlin/
*.orig.*

# ---- Environment & secrets ----
.env
.env.local
.env.*.local
!.env.example
*.keystore
!debug.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
# Firebase config files can contain API keys; keep them out unless you decide otherwise.
google-services.json
GoogleService-Info.plist

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Test coverage & caches ----
coverage/
.cache/
.eslintcache
.turbo/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors & IDEs ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
# Claude Code settings
.claude/
